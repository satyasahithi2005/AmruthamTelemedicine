{
  "name": "armutam-telemedicine-api",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js and PostgreSQL backend for a telemedicine service",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.js",
    "test": "node --test",
    "check": "node --check src/app.js && node --check src/server.js && node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "speakeasy": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
